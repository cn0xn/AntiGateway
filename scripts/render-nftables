#!/usr/bin/env python3
"""
render-nftables — единая точка шаблонизации nftables/*.nft.

Читает плейсхолдеры из /etc/antigateway/network.conf, рендерит файлы
из источника (по умолчанию /opt/antigateway/nftables) в /etc/nftables.d/,
пишет /etc/nftables.conf (явные include — glob не работает с `flush ruleset`
в nft v1.0.x).

Используется install.sh, deploy.sh и app.py (api_reset_apply) — раньше
эта логика была дублирована в трёх местах.

Применение nftables не делает — вызывайте `systemctl restart nftables`
после успешного рендера.

Usage: render-nftables [--src DIR]
       по умолчанию --src /opt/antigateway/nftables
"""
import argparse
import json
import os
import sys
import tempfile

NETWORK_CONF  = "/etc/antigateway/network.conf"
TUNNEL_DEVICES = "/etc/antigateway/tunnel-devices.json"
DST_DIR       = "/etc/nftables.d"
MAIN_CONF     = "/etc/nftables.conf"
IPV4_RE       = None  # ленивая компиляция (re импортируем ниже)

def device_tunnel_elements():
    """
    Строка для плейсхолдера __DEVICE_TUNNEL_ELEMENTS__ в 00_gateway_base.nft.
    Инлайнит IP устройств из tunnel-devices.json, чтобы set device_tunnel
    переживал restart nftables. Пусто если устройств нет / файла нет.
    """
    import re
    ipv4 = re.compile(r'^\d{1,3}(\.\d{1,3}){3}(/\d{1,2})?$')
    try:
        with open(TUNNEL_DEVICES) as f:
            data = json.load(f)
    except (FileNotFoundError, json.JSONDecodeError):
        return ""
    if not isinstance(data, list):
        return ""
    ips = []
    for rec in data:
        if isinstance(rec, dict):
            ip = str(rec.get("ip", "")).strip()
            if ipv4.match(ip):
                ips.append(ip)
    if not ips:
        return ""
    return "        elements = { " + ", ".join(ips) + " }"

def atomic_write(path, content, mode=0o644):
    fd, tmp = tempfile.mkstemp(prefix="." + os.path.basename(path) + ".",
                               dir=os.path.dirname(path))
    try:
        with os.fdopen(fd, "w") as f:
            f.write(content); f.flush(); os.fsync(f.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except Exception:
        os.unlink(tmp); raise

def main():
    p = argparse.ArgumentParser()
    p.add_argument("--src", default="/opt/antigateway/nftables")
    args = p.parse_args()

    if not os.path.isdir(args.src):
        print(f"src dir not found: {args.src}", file=sys.stderr); sys.exit(1)

    try:
        with open(NETWORK_CONF) as f:
            nc = json.load(f)
    except Exception as e:
        print(f"can't read {NETWORK_CONF}: {e}", file=sys.stderr); sys.exit(1)

    iface = nc.get("iface", "")
    pi_ip = nc.get("pi_ip", "")
    if not iface or not pi_ip:
        print("network.conf must have iface + pi_ip", file=sys.stderr); sys.exit(1)

    os.makedirs(DST_DIR, exist_ok=True)
    files = sorted(f for f in os.listdir(args.src) if f.endswith(".nft"))
    if not files:
        print(f"no .nft files in {args.src}", file=sys.stderr); sys.exit(1)

    dev_elems = device_tunnel_elements()
    for name in files:
        with open(os.path.join(args.src, name)) as f:
            content = f.read()
        content = (content
                   .replace("__IFACE__", iface)
                   .replace("__PI_IP__", pi_ip)
                   .replace("__DEVICE_TUNNEL_ELEMENTS__", dev_elems))
        atomic_write(os.path.join(DST_DIR, name), content)

    # Главный nftables.conf — явные include в нужном порядке.
    # Файлы 9*.nft пропускаются — они применяются отдельно (например
    # 90_flowtable.nft требует UP awg0, которого нет на момент main load).
    deferred = [n for n in files if n[0] == "9"]
    included = [n for n in files if n[0] != "9"]
    main_lines = ["#!/usr/sbin/nft -f", "flush ruleset"]
    for name in included:
        main_lines.append(f'include "{DST_DIR}/{name}"')
    atomic_write(MAIN_CONF, "\n".join(main_lines) + "\n")

    print(f"rendered {len(files)} nft files "
          f"(iface={iface}, pi_ip={pi_ip}; deferred: {','.join(deferred) or 'none'})")

if __name__ == "__main__":
    main()
